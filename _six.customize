// six customization entry
// - Theme colors: window.THEME
// - Runtime options controllable via :set: window.SIX_OPTIONS
//   Supported keys (initial defaults):
//     - scrolloff: number (default 3)
//     - hlsearch: boolean (default false)

// Initial :set options
window.SIX_OPTIONS = {
  GEOMETRY_IGNORE_SNAP: true,
  // scrolloff: 99999, // :set scrolloff=Nで設定した値をセッション情報に含めるのでオプションからは外した。初期値は3
  tabstop: 8, // TABコードを何桁の空白として表示するか
  // shiftwidth: 'TAB',
  visualbell: true, // ヴィジュアルベル。指定しなくてもデフォルトでON
  UNDO_STEPS_IN_SESSION: 5, // 即時終了から復帰した後まで引き継ぐアンドゥバッファの深さ(各バッファ毎に持つバッファに対する共通の深さ)
  CMD_HISTORY_IN_SESSION: 20,
  SEARCH_TERM_IN_SESSION: 20,
  GREP_BASEDIR_IN_SESSION: 20,
  GREP_FILEGLOB_IN_SESSION: 15,
  GREP_PATH_GLOB_IN_SESSION: 20,
  GREP_EXCLUDE_EXTENSIONS: [ '.png','.jpg','.jpeg','.gif','.bmp','.webp','.ico','.icns',
    '.zip','.7z','.rar','.gz','.bz2','.xz','.tar',
    '.pdf',
    '.exe','.dll','.so','.dylib','.bin',
    '.class','.jar',
    '.woff','.woff2','.ttf','.otf',
    '.mp3','.wav','.flac','.mp4','.mkv','.avi',
    '.xls','xlsx','xlsm','doc','docx','ppt','pptx', ],
  DEBUG_IME: false,
  DEBUG_IME_SCROLL: false,
  DEBUG_IME_SCROLL_STACK: false,
  DEBUG_SCAN_HOLD: false,
  DEBUG_MD_EOF: false,
  hlsearch: false, // 検索ハイライト（:set hlsearch / :set nohlsearch / :set hlsearch!）
  urllink: true,
  imeSwitchKey: 'direct',  // `かな`,`英数`
  //imeSwitchKey: 'toggle',  // `半角・全角`
  jkScrollDirection: 'reverse', // `Alt+j`がPageDown方向のスクロールになるのが'normal'(デフォルト)
  altScrollSpeedPxPerMs: 0.3,    // `Alt+j`/`Alt+k`のスピード。0.5でだいたい500px/s
  md_autoIncrement: true,
  JK_MS_PER_LINE: 120  // `j`,`k`長押しでのスクロール速度。値を小さくすると速く(粗く)なる
};

// Theme definition (色指定。基本的に全項目必須で、未定義時に代替は一切せず一律yellowとする)
window.THEME = {
//  bodyBGColor: "#0b0d12",
  bodyBGColor: "#c0c0c0",    // タブ切替時に一瞬全面塗り潰し状態で見える色
//  lineBaseFill: "#0f1117",
  lineBaseFill: "red",

  // [NORMAL]/[INSERT]/[VISUAL] text color
  modeNormalFGColor: "#e0e0e0",
  modeInsertFGColor: "#ffb0b0",
  modeVisualFGColor: "#c0daff",

  // 本文文字色
  editorTextColor: "#004a0a",

  // 行背景(カーソル外)グラデーション
  lineGradientStart: "#f6faf6",
  lineGradientEnd: "#ebeeeb",
  // 行番号背景(カーソル外)グラデーション
  inactiveGutterGradientStart: "#e8f8e8",
  inactiveGutterGradientEnd: "#d9e2d9",
  // 行番号 文字色(カーソル外)
