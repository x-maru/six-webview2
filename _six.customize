// six customization entry
// - Theme colors: window.THEME
// - Runtime options controllable via :set: window.SIX_OPTIONS
//   Supported keys (initial defaults):
//     - scrolloff: number (default 3)
//     - hlsearch: boolean (default false)

// Initial :set options
window.SIX_OPTIONS = {
  // 初期スクロールオフ
  scrolloff: 3,
  // 即時終了から復帰した後まで引き継ぐアンドゥバッファの深さ(各バッファ毎に持つバッファに対する共通の深さ)
  UNDO_STEPS_IN_SESSION: 5,
  // 検索ハイライト（:set hlsearch / :set nohlsearch / :set hlsearch!）
  hlsearch: false
};

// Theme definition (moved from _six-theme.js)
window.THEME = {
  bodyBGColor: "#0b0d12",
  lineBaseFill: "#0f1117",

  // Editor text color and sizes
  editorTextColor: "rgb(0,95,31)",

  // Inactive line/gutter gradient (top -> bottom)
  lineGradientStart: "rgb(243,251,243)",
  lineGradientEnd: "rgb(237,243,237)",
  inactiveGutterGradientStart: "rgb(235,239,235)",
  inactiveGutterGradientEnd: "rgb(219,227,219)",
  gutterNumberColor: "#b0b0b0",

  // Active line/gutter gradient (editor and gutter)
  activeLineGradientStart: "rgb(231,255,231)",
  activeLineGradientEnd: "rgb(203,243,203)",
  activeGutterGradientStart: "#d0ead0",
  activeGutterGradientEnd: "#c0dac0",
  activeLineNumberColor: "#100000",

  eofFillColor: "#0f1117",
  eofGutterFillColor: "rgb(235,239,235)",
  gutterGradientStart: "rgb(235,239,235)",
  gutterGradientEnd: "rgb(219,227,219)",

  activeLineBg: "#1b2231",

  caretGradientStart: "#ff0000",
  caretGradientMid: "rgba(255,0,0,0.5)",
  caretWidthPx: 2,

  // INSERT mode specific gradients (#437/#438)
  activeEditLineGradStart: "#fff0f0",
  activeEditLineGradEnd: "#ffe0e0",
  activeEditGutterGradStart: "#efe0e0",
  activeEditGutterGradEnd: "#efd0c0",
  editCaretGradStart: "rgba(255,79,0,0.95)",
  editCaretGradMid: "rgba(255,79,0,0.01)",

  tabBarBg: "rgb(27,47,15)",
  tabBarFg: "rgb(0,95,31)",

  // Visual selection default colors
  selectionBg: "#607080",
  selectionFg: "white",
  // Command input colors (requested: white text on black background)
  cmdInputFg: "white",
  cmdInputBg: "black",
  // Incremental search preview highlight (background/outline)
  incPreviewBg: "rgba(128,192,255,0.35)",
  incPreviewOutline: "rgba(128,192,255,0.55)",
  // hlsearch (all matches) highlight; default to yellow
  hlsearchBg: "rgba(255,255,0,0.35)",
  hlsearchOutline: "rgba(255,255,0,0.55)",
  // VISUAL after ':' selection overlay
  visCmdSelBg: "rgba(20, 192, 192, 0.2)",
  visCmdSelOutline: "rgba(0, 80, 120, 0.55)",

  // Global <kbd> colors used in tabbar and :b popup (fallbacks to helpKbd*)
  KbdBgColor: "#1c282a",
  KbdFgColor: "#90aada",

  // Help modal theming
  helpTabActiveBg: "#2b7050",
  helpTabActiveFg: "#e0efe6",
  helpTabBg: "#1e241a",
  helpTabFg: "#a0aaa0",
  helpModalBg: "#041a10",
  helpKbdBg: "#1c282a",
  helpKbdFg: "#90aada",
  // Help close button (themeable)
  helpCloseBg: "#3a3a56",
  helpCloseFg: "#e6e6e6",
  helpCloseBorder: "#3f5074",
  // Popup active line highlight (encodeSet popupなど)
  popupActiveLine: "#00a090"
};
