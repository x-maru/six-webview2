// six customization entry
// - Theme colors: window.THEME
// - Runtime options controllable via :set: window.SIX_OPTIONS
//   Supported keys (initial defaults):
//     - scrolloff: number (default 3)
//     - hlsearch: boolean (default false)

// Initial :set options
window.SIX_OPTIONS = {
  // scrolloff: 99999, // :set scrolloff=Nで設定した値をセッション情報に含めるのでオプションからは外した。初期値は3
  tabstop: 8, // TABコードを何桁の空白として表示するか
  visualbell: true, // ヴィジュアルベル。指定しなくてもデフォルトでON
  UNDO_STEPS_IN_SESSION: 5, // 即時終了から復帰した後まで引き継ぐアンドゥバッファの深さ(各バッファ毎に持つバッファに対する共通の深さ)
  hlsearch: false, // 検索ハイライト（:set hlsearch / :set nohlsearch / :set hlsearch!）
  urllink: true,
  imeSwitchKey: 'direct',
  //imeSwitchKey: 'toggle',
  jkScrollDirection: 'reverse'  // `Alt+j`がPageDown方向のスクロールになるのが'normal'(デフォルト)
};

// Theme definition (色指定。基本的に全項目必須で、未定義時に代替は一切せず一律yellowとする)
window.THEME = {
  bodyBGColor: "#0b0d12",
  lineBaseFill: "#0f1117",

  // [NORMAL]/[INSERT]/[VISUAL] text color
  modeNormalFGColor: "#e0e0e0",
  modeInsertFGColor: "#ffb0b0",
  modeVisualFGColor: "#c0daff",

  // 本文文字色
  editorTextColor: "#004a0a",

  // 行背景(カーソル外)グラデーション
  lineGradientStart: "#f4fff4",
  lineGradientEnd: "#f5f7f5",
  // 行番号背景(カーソル外)グラデーション
  inactiveGutterGradientStart: "#e8f8e8",
  inactiveGutterGradientEnd: "#d9e2d9",
  // 行番号 文字色(カーソル外)
  gutterNumberColor: "#808080",

  // 行背景(NORMALカーソル行)グラデーション
  activeLineGradientStart: "#e4ffe4",
  activeLineGradientEnd: "#e0fbe0",
  // 行番号背景(NORMALカーソル行)グラデーション
  activeGutterGradientStart: "#d0ead0",
  activeGutterGradientEnd: "#c0dac0",
  // 行背景(INSERTカーソル行)グラデーション
  activeEditLineGradStart: "#fff0f0",
  activeEditLineGradEnd: "#ffe0e0",
  // 行番号背景(INSERTカーソル行)グラデーション
  activeEditGutterGradStart: "#efe0e0",
  activeEditGutterGradEnd: "#efd0c0",
  // 行番号(NORMAL/INSERTカーソル行) 文字色
  activeLineNumberColor: "#20a090",

  eofGutterFillColor: "rgb(235,239,235)",
  gutterGradientStart: "rgb(235,239,235)",
  gutterGradientEnd: "rgb(219,227,219)",

  // NORMAL/VISUALでIME OFFのcaretグラデーション(左→右の方向)
  caretGradStart: "rgba(255,79,0,0.95)",
  caretGradMid: "rgba(255,79,0,0.05)",

  // NORMAL/VISUALでIME ONのcaretグラデーション
  caretIMEGradStart: "rgba(0,0,0,0.9)",
  caretIMEGradMid: "rgba(0,0,0,0.9)",

  // INSERTでIME OFFのcaretグラデーション
  editCaretGradStart: "rgba(255,79,0,0.95)",
  editCaretGradMid: "rgba(255,79,0,0.05)",

  // INSERTでIME ONのcaretグラデーション
  editCaretIMEGradStart: "rgba(113,247,31, 0.95)",
  editCaretIMEGradMid: "rgba(113,247,31,0.05)",

  // タブバー
  tabBarBg: "#102a10",
  tabBg: "#2a4020",
  tabText: "#e0ffe0",
  activeTabBg: "#c0eae0",
  activeTabText: "#406a60",
  tabScrollBtnEnableBG: "#40d040", // タブスクロールボタン(活性)
  tabScrollBtnEnableText: "#008000", // タブスクロールボタン(活性)
  tabScrollBtnDisableBG: "#102a10", // タブスクロールボタン(非活性)
  tabScrollBtnDisableText: "#305030", // タブスクロールボタン(非活性)
  posInfoText: "#c0ffca", // "行Y, 列X/W"

  // Visual selection default colors
  selectionBg: "#607080",
  selectionFg: "white",
  // Command input colors (requested: white text on black background)
  cmdInputFg: "white",
  cmdInputBg: "black",
  // Incremental search preview highlight (background/outline)
  incPreviewBg: "rgba(128,192,255,0.35)",
  incPreviewOutline: "rgba(128,192,255,0.55)",
  // hlsearch (all matches) highlight; default to yellow
  hlsearchBg: "rgba(255,255,0,0.35)",
  hlsearchOutline: "rgba(255,255,0,0.55)",
  // VISUAL after ':' selection overlay
  visCmdSelBg: "rgba(20, 192, 192, 0.2)",
  visCmdSelOutline: "rgba(0, 80, 120, 0.55)",

  // yank/clipboardに格納した際の短時間フラッシュ。`n`,`N`でヒットしたときの効果にも流用する
  yankFlashColor: "#ffb020",

  // URLと認識した文字列にマウスホバーしたときの背景の色(オーバーレイなので半透明にしないと文字が見えない)
  linkHoverBg: "rgba(15,179,255,0.1)",

  // Global <kbd> colors used in tabbar and :b popup (fallbacks to helpKbd*)
  KbdBgColor: "#1c282a",
  KbdFgColor: "#aadada",

  // 制御文字
  controlCharColor: "#80d0d0",
  controlCharColorLF: "#a0eada",
  controlCharColorCRLF: "#2050c0",
  dummyLFColor: "orange",
  dummyCRLFColor: "#d0a0f0",

  // Help modal theming
  helpTabActiveBg: "#2b7050",
  helpTabActiveFg: "#e0efe6",
  helpTabBg: "#1e241a",
  helpTabFg: "#a0aaa0",
  helpModalBg: "#041a10",
  helpKbdBg: "#222a2c",
  helpKbdFg: "#aabada",
  // Help close button (themeable)
  helpCloseBg: "#3a3a56",
  helpCloseFg: "#e6e6e6",
  helpCloseBorder: "#3f5074",

  // Popup (:e popup, :b popup, encodeSet popupなど)
  popupActiveLine: "#00a090", // active line highlight
  popupHeaderBg: "#000030"
};

// かな/カナでの長音として扱う記号 (単語単位の移動に利用)。コードポイント配列。
// 必須: 未定義/空配列なら起動時にエラー。
window.SIX_LONG_SOUND_LIKE = [
  0x30FC, // ー Prolonged Sound Mark
  0xFF70, // ｰ Halfwidth Prolonged Sound Mark
  0xFF0D, // Fullwidth Hyphen-Minus
  0x2212, // Minus Sign
  0x2010, // Hyphen
  0x2013, // En Dash
  0x2014, // Em Dash
  0x2015  // Horizontal Bar
];
