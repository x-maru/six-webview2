  activeGutterGradientStart: "#e2f0ed",
  activeGutterGradientEnd: "#deebea",
  // 行背景(INSERTカーソル行)グラデーション
  activeEditLineGradStart: "#fff0f0",
  activeEditLineGradEnd: "#ffe0e0",
  // 行番号背景(INSERTカーソル行)グラデーション
  activeEditGutterGradStart: "#efe0e0",
  activeEditGutterGradEnd: "#efd0c0",
  // 行番号(NORMAL/INSERTカーソル行) 文字色
  activeLineNumberColor: "#20a090",

  // コードブロック内 文字色
  blockFGColor: "#f0f0f0",

  // コードブロック内 背景
  blockBGColor: "#202020",

  // 行背景(コードブロック内NORMALカーソル行)グラデーション
  blockActiveLineGradStart: "#203024",
  blockActiveLineGradEnd: "#102a14",

  // 行背景(コードブロック内INSERTカーソル行)グラデーション
  blockActiveEditLineGradStart: "#3a2a2a",
  blockActiveEditLineGradEnd: "#302020",

  eofGutterFillColor: "rgb(235,239,235)",
  gutterGradientStart: "rgb(235,239,235)",
  gutterGradientEnd: "rgb(219,227,219)",

  // NORMAL/VISUALでIME OFFのcaretグラデーション(左→右の方向)
  caretGradStart: "rgba(0,115,79,0.95)",
  caretGradMid: "rgba(0,115,79,0.04)",

  // NORMAL/VISUALでIME ONのcaretグラデーション
  caretIMEGradStart: "rgba(0,0,0,0.9)",
  caretIMEGradMid: "rgba(0,0,0,0.9)",

  // INSERTでIME OFFのcaretグラデーション
  editCaretGradStart: "rgba(255,79,0,0.95)",
  editCaretGradMid: "rgba(255,79,0,0.05)",

  // INSERTでIME ONのcaretグラデーション
  editCaretIMEGradStart: "rgba(113,247,31, 0.95)",
  editCaretIMEGradMid: "rgba(113,247,31,0.05)",

  // タブバー
  tabBarBg: "#102a10",
  tabBg: "#2a4020",
  tabText: "#e0ffe0",
  activeTabBg: "#c0eae0",
  activeTabText: "#406a60",
  tabScrollBtnEnableBG: "#40d040", // タブスクロールボタン(活性)
  tabScrollBtnEnableText: "#008000", // タブスクロールボタン(活性)
  tabScrollBtnDisableBG: "#102a10", // タブスクロールボタン(非活性)
  tabScrollBtnDisableText: "#305030", // タブスクロールボタン(非活性)
  posInfoText: "#c0ffca", // "行Y, 列X/W"

  // VISUAL選択の色
  selectionFg: "white",
  selectionBg: "#001d44",

  // コマンドバー内の色
  cmdInputFg: "white",
  cmdInputBg: "#002000",

  // Incremental search preview highlight (background/outline)
  incPreviewBg: "rgba(128,192,255,0.35)",
  incPreviewOutline: "rgba(128,192,255,0.55)",
  // hlsearch (all matches) highlight; default to yellow
  hlsearchBg: "rgba(255,255,0,0.35)",
  hlsearchOutline: "rgba(255,255,0,0.55)",
  // VISUAL after ':' selection overlay
  visCmdSelBg: "rgba(20, 192, 192, 0.2)",
  visCmdSelOutline: "rgba(0, 80, 120, 0.55)",

  // yank/clipboardに格納した際の短時間フラッシュ。`n`,`N`でヒットしたときの効果にも流用する
  yankFlashColor: "#ffb020",

  // URLと認識した文字列にマウスホバーしたときの背景の色(オーバーレイなので半透明にしないと文字が見えない)
  linkHoverBg: "rgba(15,179,255,0.1)",

  // Global <kbd> colors used in tabbar and :b popup (fallbacks to helpKbd*)
  KbdBgColor: "#1c282a",
  KbdFgColor: "#aadada",

  // 制御文字
  controlCharColor: "#80d0d0",
  controlCharColorLF: "#a0eada",
  controlCharColorCRLF: "#2050c0",
  dummyLFColor: "orange",
  dummyCRLFColor: "#d0a0f0",

  // Popup (:e popup, :b popup, encodeSet popupなど)
  popupActiveLine: "#00a090", // active line highlight
  popupHeaderBg: "#000030",

  // オーバーレイパレット内のボタン
  btnFg: "#c9cacd",	// 文字色
  overlayBtnBg: "#2b313f",	// BG
  

  // Markdownインラインコード
  inlineCodeBG: "#607a70",
  inlineCodeBorderUL: "#eaf0ea",
  inlineCodeBorderBR: "#607060"
};

